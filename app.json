{
  "expo": {
    "name": "Tapakeel Ticket Scan",
    "slug": "tapakeel-e-tickets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/icons.svg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "L'application nécessite l'accès à la caméra pour scanner les billets.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à vos photos pour envoyer des médias dans le chat."
      },
      "bundleIdentifier": "com.tapakeel.scanapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tapakeel.scanapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/brand/home-logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tapakeel to access your camera to scan tickets."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/home-logo.png",
          "color": "#224798",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tapakeel a besoin d'accéder à vos photos pour envoyer des médias dans le chat.",
          "cameraPermission": "Tapakeel a besoin de votre caméra pour prendre des photos."
        }
      ]
    ],
    "owner": "tsyresy",
    "extra": {
      "eas": {
        "projectId": "502e97d1-9ff9-4f10-95f9-ff323dad4543"
      }
    }
  }
}
